# Sao chép file này thành .env rồi chỉnh giá trị cho máy của bạn:
#   cp .env.example .env

# Profile cấu hình: "local" (máy cá nhân, model nhẹ) hoặc "server" (model lớn + reranker)
RAG_PROFILE=local

# Địa chỉ Ollama server (chỉ profile "server" đọc biến này)
OLLAMA_BASE_URL=http://localhost:11434
